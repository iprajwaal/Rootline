diff --git a/src/components/thread/alerts/index.tsx b/src/components/thread/alerts/index.tsx
new file mode 100644
index 0000000..1ef8b2f
--- /dev/null
+++ b/src/components/thread/alerts/index.tsx
@@ -0,0 +1,166 @@
+"use client";
+
+import { useCallback, useEffect, useState } from "react";
+import { parseAsBoolean, useQueryState } from "nuqs";
+import { BellRing } from "lucide-react";
+import { Button } from "@/components/ui/button";
+import { cn } from "@/lib/utils";
+
+// Rootline's API keeps the alerts; a chat thread starts only when someone opens one.
+const ROOTLINE_API =
+  process.env.NEXT_PUBLIC_ROOTLINE_API_URL || "http://localhost:8000";
+const POLL_MS = 5000;
+
+export type Incident = {
+  id: number;
+  alert_name: string | null;
+  service: string | null;
+  status: string;
+  fire_count: number;
+  created_at: string;
+  resolved_at: string | null;
+  thread_id: string | null;
+  chat_opened: boolean;
+  top_rca: string | null;
+  top_sop: string | null;
+};
+
+export function useIncidents(): Incident[] {
+  const [incidents, setIncidents] = useState<Incident[]>([]);
+
+  useEffect(() => {
+    let stopped = false;
+    const load = () =>
+      fetch(`${ROOTLINE_API}/incidents?status=all&limit=30`)
+        .then((response) => (response.ok ? response.json() : []))
+        .then((rows: Incident[]) => {
+          if (!stopped) setIncidents(rows);
+        })
+        .catch(() => undefined);
+    load();
+    const timer = setInterval(load, POLL_MS);
+    return () => {
+      stopped = true;
+      clearInterval(timer);
+    };
+  }, []);
+
+  return incidents;
+}
+
+function label(incident: Incident): string {
+  if (incident.status !== "open") return "resolved";
+  return incident.chat_opened ? "in chat" : "new";
+}
+
+export function AlertList({ onOpen }: { onOpen?: () => void }) {
+  const incidents = useIncidents();
+  const [, setThreadId] = useQueryState("threadId");
+  const [opening, setOpening] = useState<number | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  const open = useCallback(
+    async (incident: Incident) => {
+      setError(null);
+      setOpening(incident.id);
+      try {
+        const response = await fetch(
+          `${ROOTLINE_API}/incidents/${incident.id}/open`,
+          { method: "POST" },
+        );
+        if (!response.ok) {
+          setError("Could not open this alert. Is the agent server running?");
+          return;
+        }
+        const { thread_id } = await response.json();
+        setThreadId(thread_id);
+        onOpen?.();
+      } finally {
+        setOpening(null);
+      }
+    },
+    [setThreadId, onOpen],
+  );
+
+  if (!incidents.length) {
+    return <p className="px-4 text-sm text-gray-500">No alerts yet.</p>;
+  }
+
+  return (
+    <div className="flex h-full w-full flex-col gap-2 overflow-y-auto px-3">
+      {error && <p className="text-sm text-red-600">{error}</p>}
+      {incidents.map((incident) => (
+        <button
+          key={incident.id}
+          onClick={() => open(incident)}
+          disabled={opening !== null}
+          className={cn(
+            "w-full rounded-md border px-3 py-2 text-left hover:bg-gray-50",
+            incident.status === "open"
+              ? "border-red-300"
+              : "border-gray-200 opacity-70",
+          )}
+        >
+          <div className="flex items-center justify-between gap-2">
+            <span className="truncate text-sm font-medium">
+              {incident.alert_name}
+            </span>
+            <span
+              className={cn(
+                "shrink-0 rounded-full px-2 text-xs",
+                label(incident) === "new"
+                  ? "bg-red-600 text-white"
+                  : "bg-gray-100 text-gray-600",
+              )}
+            >
+              {opening === incident.id ? "opening" : label(incident)}
+            </span>
+          </div>
+          <p className="text-xs text-gray-500">
+            {incident.service} ·{" "}
+            {new Date(incident.created_at).toLocaleTimeString()}
+            {incident.fire_count > 1 ? ` · fired ${incident.fire_count} times` : ""}
+          </p>
+          {incident.top_sop && (
+            <p className="truncate text-xs text-gray-600">{incident.top_sop}</p>
+          )}
+          {incident.top_rca && (
+            <p className="truncate text-xs text-gray-600">{incident.top_rca}</p>
+          )}
+        </button>
+      ))}
+    </div>
+  );
+}
+
+export function AlertsButton() {
+  const incidents = useIncidents();
+  const [, setChatHistoryOpen] = useQueryState(
+    "chatHistoryOpen",
+    parseAsBoolean.withDefault(false),
+  );
+  const [, setHistoryTab] = useQueryState("historyTab");
+  const waiting = incidents.filter(
+    (incident) => incident.status === "open" && !incident.chat_opened,
+  ).length;
+
+  return (
+    <Button
+      variant="outline"
+      size="sm"
+      className="gap-2"
+      onClick={() => {
+        setHistoryTab("alerts");
+        setChatHistoryOpen(true);
+      }}
+    >
+      <BellRing className="size-4" />
+      Alerts
+      {waiting > 0 && (
+        <span className="rounded-full bg-red-600 px-2 text-xs text-white">
+          {waiting}
+        </span>
+      )}
+    </Button>
+  );
+}
