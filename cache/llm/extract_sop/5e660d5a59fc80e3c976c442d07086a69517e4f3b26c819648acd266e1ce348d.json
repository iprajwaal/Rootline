{
  "purpose": "Replace the payment-gateway API key when it has expired or is about to expire.",
  "scope": "",
  "when_to_use": "Use this when the PaymentAuthFailures alert fires, or orders-api logs show \"payment-gateway returned 401 Unauthorized: api key expired\".",
  "alerts": [],
  "definitions": [],
  "roles": [],
